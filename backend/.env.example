# ===== CRITICAL SECURITY =====
# NEVER commit actual values - use strong, unique values in production

# MongoDB Configuration (REQUIRED)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/car_marketplace?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (CRITICAL - Must be minimum 32 characters, strong random string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_strong_random_string_minimum_32_characters_unique_per_environment

# Cloudinary Configuration (REQUIRED for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Configuration (Change in production!)
# For security: use strong password (16+ chars, mixed case, numbers, symbols)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_SuperStrong123!

# CORS Origins (comma-separated list of allowed domains)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: WhatsApp API Configuration
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_whatsapp_token

# Optional: Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password

# Optional: Sentry Error Tracking (for production monitoring)
SENTRY_DSN=

# Optional: Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
