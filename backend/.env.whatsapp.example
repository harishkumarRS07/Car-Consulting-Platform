# ========================================
# 🚗 CarConsult Backend Environment Variables
# ========================================

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carconsult

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# 🟢 WhatsApp Cloud API Configuration
# ========================================
# Get these from Meta Business Account setup
# See docs/WHATSAPP_SETUP_GUIDE.md for detailed setup

# Meta WhatsApp Phone Number ID (found in App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Meta WABA ID (found in Business Manager)
WHATSAPP_WABA_ID=987654321098765

# Meta App Access Token (generated from System User)
# 🔐 KEEP THIS SECRET - Never share or commit to git!
WHATSAPP_ACCESS_TOKEN=ABCdef12345GHIjkl67890MNOpqrst...

# Your business phone number where notifications are received
# Format: Include country code without + (e.g., 919876543210 for +91 India)
WHATSAPP_BUSINESS_PHONE_NUMBER=919876543210

# Optional: Multiple admin phone numbers (comma-separated)
# WHATSAPP_ADMIN_PHONES=919876543210,919987654321

# Optional: Enable customer notifications (true/false)
WHATSAPP_CUSTOMER_NOTIFICATIONS=false

# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# CORS Configuration
# ========================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
