# Docker environment file for docker-compose
# Copy this to .env.docker and update with your values

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_this_strong_password_123!

# Node Environment
NODE_ENV=production

# Backend Configuration
JWT_SECRET=generate_strong_random_string_minimum_32_characters_unique
ADMIN_EMAIL=admin@carconsult.com
ADMIN_PASSWORD=ChangeMe_SuperStrong123!

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Origins
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com
